DATABASE_URL="postgresql://user:password@host/db?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://user:password@host/db?sslmode=require&channel_binding=require"
AUTH_SECRET="generate-with-openssl-rand-base64-32"
APP_URL="http://localhost:3000"

# Gmail SMTP (solution temporaire dev/test — voir commentaire dans src/lib/email.ts)
# Mot de passe d'application à générer sur myaccount.google.com/apppasswords
# (nécessite la validation en 2 étapes activée sur le compte Google)
GMAIL_USER="votre-adresse@gmail.com"
GMAIL_APP_PASSWORD="xxxxxxxxxxxxxxxx"

# Vercel → Storage → Blob → Create Store
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Google AI Studio → aistudio.google.com/apikey (gratuit)
GEMINI_API_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Optionnel — valeur par défaut dans le code si absente
GEMINI_MODEL="gemini-3.6-flash"

# Y-Sweet (backend Yjs hébergé, sans badge — remplace Liveblocks) — deux façons de l'obtenir :
# - Dev local : `npx y-sweet serve` (aucun compte requis), copier la connection string
#   ys://127.0.0.1:PORT affichée au démarrage.
# - Prod : y-sweet.dev → créer un serveur géré (tier gratuit), copier la connection string
#   yss://... fournie (ou auto-héberger, voir la doc Y-Sweet).
Y_SWEET_CONNECTION_STRING="ys://127.0.0.1:8080"

# adobe.io/console → créer un projet → ajouter l'API "PDF Services API" → credentials
# (tier gratuit, 500 conversions/mois). Utilisé pour convertir les mémoires PDF en
# DOCX structuré (titres, paragraphes, listes préservés) avant édition.
ADOBE_PDF_SERVICES_CLIENT_ID="xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
ADOBE_PDF_SERVICES_CLIENT_SECRET="xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Anti-plagiat externe — sources académiques (voir src/lib/plagiarism-external.ts)
# OpenAlex et HAL sont publiques, sans clé, déjà actives sans rien configurer ici.

# Optionnel — "polite pool" OpenAlex (traitement prioritaire), pas requis pour fonctionner.
OPENALEX_MAILTO="votre-adresse@exemple.com"

# CORE (core.ac.uk) → documentation développeur → "CORE API" → inscription (gratuite,
# immédiate). Sans cette clé, la source CORE est désactivée silencieusement (juste un
# avertissement dans les logs serveur).
CORE_API_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
