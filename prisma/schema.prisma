generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  INSTITUTION
  JURY
  STUDENT
}

enum MemoireStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum FileType {
  PDF
  DOCX
}

enum MemoireSource {
  UPLOADED
  DRAFTED
}

enum ChatRole {
  USER
  ASSISTANT
}

enum QuestionType {
  QCU
  VRAI_FAUX
  TEXTE_TROU
}

enum JuryQuestionCategory {
  METHODOLOGIE
  RESULTATS
  REVUE_LITTERATURE
  PROBLEMATIQUE
  PERSPECTIVES
}

enum StudyLevel {
  LICENCE
  MASTER
  DOCTORAT
}

enum JuryFunction {
  ENSEIGNANT
  PROFESSIONNEL
}

enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum ThemeStatus {
  PROPOSED
  VALIDATED
  REJECTED
}

enum AssignmentStatus {
  SUGGESTED
  VALIDATED
}

enum ThemeSelectionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ThemeClosureReason {
  COMPLETED
  ABANDONED
}

enum ThemeClosureStatus {
  PENDING
  APPROVED
  REJECTED
}

model Institution {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  country   String?
  city      String?
  website   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users    User[]
  memoires Memoire[]
  themes   Theme[]
}

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  emailVerified DateTime?
  passwordHash  String
  name          String
  role          Role
  institutionId String?
  institution   Institution? @relation(fields: [institutionId], references: [id])
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  // Vrai pour les comptes créés directement par un établissement (ex. compte jury avec
  // mot de passe temporaire) — force un changement de mot de passe avant tout accès au
  // dashboard (voir requireRole dans src/lib/auth-guard.ts), puis repasse à false.
  mustChangePassword Boolean @default(false)

  // Renseigné quand l'établissement saisi à l'inscription (étudiant/jury) ne
  // correspond à aucune Institution existante ; à rattacher manuellement plus tard.
  affiliatedInstitutionName String?
  country                   String?

  // Étudiant
  fieldOfStudy  String?
  studyLevel    StudyLevel?
  studentNumber String?

  // Jury
  specialty    String?
  juryFunction JuryFunction?

  memoiresDeposes Memoire[]           @relation("MemoireStudent")
  evaluationsJury DefenseEvaluation[]
  quizAttempts    QuizAttempt[]
  authTokens      AuthToken[]
  notifications   Notification[]

  proposedThemes  Theme[]             @relation("ThemeProposedBy")
  juryAssignments MemoireAssignment[] @relation("JuryAssignments")

  // Thème choisi/proposé par l'étudiant en amont du dépôt (avant qu'un Memoire n'existe) —
  // condition pour débloquer le dépôt de mémoire. Distinct de Memoire.themeId, qui n'est
  // qu'une copie faite au moment du dépôt. N'est renseigné que via une ThemeSelection
  // APPROVED (voir plus bas) — un currentTheme pointe donc toujours vers un thème VALIDATED.
  currentThemeId String?
  currentTheme   Theme?  @relation("StudentCurrentTheme", fields: [currentThemeId], references: [id])

  // Thème verrouillé sur cet étudiant une fois sa demande de sélection approuvée — au plus
  // un thème "pris" par utilisateur (contrainte applicative, pas de @@unique ici car
  // takenByUserId vit sur Theme).
  takenThemes     Theme[]           @relation("ThemeTakenBy")
  themeSelections ThemeSelection[]
  themeClosures   ThemeClosureRequest[]
}

model AuthToken {
  id        String        @id @default(cuid())
  token     String        @unique
  type      AuthTokenType
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([userId, type])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   String
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

model Memoire {
  id            String        @id @default(cuid())
  title         String
  // Nullables : un mémoire DRAFTED (rédigé directement dans l'éditeur, voir source
  // ci-dessous) n'a jamais de fichier source — toujours renseignés ensemble pour un
  // mémoire UPLOADED, toujours absents ensemble pour un DRAFTED.
  fileUrl       String?
  fileType      FileType?
  // Origine du mémoire : déposé par upload (comportement historique, passe par
  // processMemoire) ou rédigé à partir de zéro dans l'éditeur (status directement
  // COMPLETED à la création, editableContent pré-rempli d'un squelette — voir
  // createDraftMemoireAction). Champ technique, jamais montré à l'étudiant.
  source        MemoireSource @default(UPLOADED)
  status        MemoireStatus @default(PENDING)
  extractedText String?       @db.Text
  errorMessage  String?

  // Signature de contenu utilisée pour la détection anti-plagiat : recalculée à chaque
  // traitement, et réutilisée comme corpus de comparaison pour les mémoires suivants.
  contentEmbedding    Json?
  contentFingerprints Json?

  // Version HTML éditable du mémoire (générée à partir du DOCX via mammoth, ou reconstruite
  // par paragraphes depuis extractedText pour un PDF) — le contenu "vivant" affiché/édité
  // dans la vue document, distinct du fichier original conservé dans fileUrl.
  editableContent String? @db.Text
  studentId     String
  student       User          @relation("MemoireStudent", fields: [studentId], references: [id])
  institutionId String
  institution   Institution   @relation(fields: [institutionId], references: [id])
  submittedAt   DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Thème choisi (dans la liste validée de l'établissement) ou proposé par l'étudiant —
  // nullable : un mémoire peut exister avant qu'un thème soit choisi/validé.
  themeId String?
  theme   Theme?  @relation(fields: [themeId], references: [id])

  auditReport      AuditReport?
  plagiarismReport PlagiarismReport?
  quiz             Quiz?
  jurySimulation   JurySimulation?
  evaluations      DefenseEvaluation[]
  assignments      MemoireAssignment[]
  aiChatMessages   AiChatMessage[]
}

// Historique de la conversation avec l'assistant IA de co-rédaction, dans l'éditeur de
// document — un mémoire = un fil de discussion continu (pas de notion de "session" séparée).
// Étudiant uniquement (voir sendAiChatMessageAction) ; jamais montré au jury.
model AiChatMessage {
  id        String   @id @default(cuid())
  memoireId String
  memoire   Memoire  @relation(fields: [memoireId], references: [id])
  role      ChatRole
  content   String   @db.Text
  createdAt DateTime @default(now())

  @@index([memoireId, createdAt])
}

model Theme {
  id          String      @id @default(cuid())
  title       String
  description String?

  // Catégorie/domaine du thème, utilisée pour le matching avec la spécialité (User.specialty)
  // d'un jury lors de la suggestion d'assignation — comparaison texte simple (voir
  // src/lib/jury-assignment.ts), pas d'embeddings pour cette itération.
  category String

  status        ThemeStatus @default(PROPOSED)
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])

  // Renseigné si le thème a été proposé par un étudiant (à valider par l'établissement) ;
  // null si créé directement par l'établissement (déjà VALIDATED).
  proposedByUserId String?
  proposedBy       User?    @relation("ThemeProposedBy", fields: [proposedByUserId], references: [id])

  // Renseigné dès qu'une demande de sélection est approuvée pour cet étudiant — le thème
  // n'est alors plus disponible pour personne d'autre (exclusivité). Distinct du statut
  // VALIDATED du thème, qui ne concerne que sa proposition initiale.
  takenByUserId String?
  takenBy       User?   @relation("ThemeTakenBy", fields: [takenByUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memoires        Memoire[]
  currentByUsers  User[]                @relation("StudentCurrentTheme")
  selections      ThemeSelection[]
  closureRequests ThemeClosureRequest[]
}

// Demande d'un étudiant pour obtenir un thème déjà VALIDATED (établissement ou son propre
// thème proposé) — séparée du statut de proposition du thème lui-même : un thème VALIDATED
// peut avoir une sélection PENDING/APPROVED/REJECTED en cours pour un étudiant donné.
// L'approbation renseigne Theme.takenByUserId + User.currentThemeId (voir
// approveThemeSelectionAction).
model ThemeSelection {
  id        String               @id @default(cuid())
  themeId   String
  theme     Theme                @relation(fields: [themeId], references: [id])
  studentId String
  student   User                 @relation(fields: [studentId], references: [id])
  status    ThemeSelectionStatus @default(PENDING)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([themeId, status])
  @@index([studentId, status])
}

// Demande de clôture d'un thème actif par l'étudiant qui le détient (Theme.takenByUserId) —
// COMPLETED (terminé/soutenu) ou ABANDONED, soumise à validation établissement comme le
// reste du système de thèmes. Le thème reste actif/utilisable tant que la demande est
// PENDING. À l'approbation (voir approveThemeClosureAction) : COMPLETED laisse
// Theme.takenByUserId inchangé (indisponible pour toujours) tandis qu'ABANDONED le remet à
// null (redevient disponible) ; dans les deux cas User.currentThemeId de l'étudiant repasse
// à null. Ne touche jamais Memoire.themeId ni MemoireAssignment — les mémoires déjà déposés
// sous ce thème gardent leur lien et leur éventuelle assignation jury intacts.
model ThemeClosureRequest {
  id        String              @id @default(cuid())
  themeId   String
  theme     Theme               @relation(fields: [themeId], references: [id])
  studentId String
  student   User                @relation(fields: [studentId], references: [id])
  reason    ThemeClosureReason
  status    ThemeClosureStatus  @default(PENDING)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@index([themeId, status])
  @@index([studentId, status])
}

// Historique des assignations mémoire -> jury : une nouvelle ligne à chaque changement
// (plutôt qu'une mise à jour en place), pour garder la trace de qui a été assigné et
// quand. L'assignation "active" pour un mémoire est la ligne la plus récente
// (orderBy assignedAt desc, take 1).
model MemoireAssignment {
  id        String           @id @default(cuid())
  memoireId String
  memoire   Memoire          @relation(fields: [memoireId], references: [id])
  juryId    String
  jury      User             @relation("JuryAssignments", fields: [juryId], references: [id])
  status    AssignmentStatus @default(SUGGESTED)
  assignedAt DateTime        @default(now())

  @@index([memoireId, assignedAt])
}

model AuditReport {
  id                  String   @id @default(cuid())
  memoireId           String   @unique
  memoire             Memoire  @relation(fields: [memoireId], references: [id])
  score               Float
  structureScore      Float
  coherenceScore      Float
  writingQualityScore Float
  recommendations     Json
  createdAt           DateTime @default(now())
}

model PlagiarismReport {
  id              String   @id @default(cuid())
  memoireId       String   @unique
  memoire         Memoire  @relation(fields: [memoireId], references: [id])
  similarityScore Float
  matches         Json
  certificateUrl  String?
  qrCodeUrl       String?
  createdAt       DateTime @default(now())
}

model Quiz {
  id        String   @id @default(cuid())
  memoireId String   @unique
  memoire   Memoire  @relation(fields: [memoireId], references: [id])
  createdAt DateTime @default(now())

  questions QuizQuestion[]
  attempts  QuizAttempt[]
}

model QuizQuestion {
  id            String       @id @default(cuid())
  quizId        String
  quiz          Quiz         @relation(fields: [quizId], references: [id])
  type          QuestionType
  question      String
  choices       Json?
  correctAnswer String
  order         Int
}

model QuizAttempt {
  id          String   @id @default(cuid())
  quizId      String
  quiz        Quiz     @relation(fields: [quizId], references: [id])
  studentId   String
  student     User     @relation(fields: [studentId], references: [id])
  score       Float
  answers     Json
  completedAt DateTime @default(now())
}

model JurySimulation {
  id        String   @id @default(cuid())
  memoireId String   @unique
  memoire   Memoire  @relation(fields: [memoireId], references: [id])
  createdAt DateTime @default(now())

  questions JuryQuestion[]
}

model JuryQuestion {
  id               String               @id @default(cuid())
  jurySimulationId String
  jurySimulation   JurySimulation       @relation(fields: [jurySimulationId], references: [id])
  category         JuryQuestionCategory
  question         String
  order            Int
}

model DefenseEvaluation {
  id        String   @id @default(cuid())
  memoireId String
  memoire   Memoire  @relation(fields: [memoireId], references: [id])
  juryId    String
  jury      User     @relation(fields: [juryId], references: [id])
  grade     Float
  criteria  Json
  comments  String?
  createdAt DateTime @default(now())
}
