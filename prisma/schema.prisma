generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  INSTITUTION
  JURY
  STUDENT
}

enum PlanRole {
  STUDENT
  INSTITUTION
}

enum PlanBillingCycle {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  EXPIRED
}

enum MemoireStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum FileType {
  PDF
  DOCX
}

enum MemoireSource {
  UPLOADED
  DRAFTED
}

enum ChatRole {
  USER
  ASSISTANT
}

enum QuestionType {
  QCU
  VRAI_FAUX
  TEXTE_TROU
}

enum JuryQuestionCategory {
  METHODOLOGIE
  RESULTATS
  REVUE_LITTERATURE
  PROBLEMATIQUE
  PERSPECTIVES
}

enum StudyLevel {
  LICENCE
  MASTER
  DOCTORAT
}

enum JuryFunction {
  ENSEIGNANT
  PROFESSIONNEL
}

enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum ThemeStatus {
  PROPOSED
  VALIDATED
  REJECTED
}

enum AssignmentStatus {
  SUGGESTED
  VALIDATED
}

enum ThemeSelectionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ThemeClosureReason {
  COMPLETED
  ABANDONED
}

enum ThemeClosureStatus {
  PENDING
  APPROVED
  REJECTED
}

model Institution {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  country   String?
  city      String?
  website   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users        User[]
  memoires     Memoire[]
  themes       Theme[]
  subscription Subscription?
}

// Catalogue des plans — synchronisé depuis src/lib/pricing-config.ts (source de vérité,
// jamais édité à la main en base, voir syncPlansFromConfig dans src/lib/subscription.ts).
// Un compte sans Subscription active retombe sur le plan FREE de son rôle.
model Plan {
  id          String   @id @default(cuid())
  role        PlanRole
  code        String
  name        String
  description String

  // Limites du plan — JSON plutôt que colonnes dédiées : la forme diffère selon le rôle
  // (StudentPlanLimits / InstitutionPlanLimits, voir pricing-config.ts) et de nouvelles
  // limites pourront s'ajouter sans migration de schéma.
  limits Json

  // FCFA, montant entier — null si l'option n'existe pas pour ce plan (Free, ou pas
  // d'offre annuelle pour les plans établissement). Montants provisoires, voir
  // pricing-config.ts.
  priceMonthlyFcfa Int?
  priceYearlyFcfa  Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]

  @@unique([role, code])
}

// Un abonnement par compte (étudiant ou établissement, jamais les deux) — mis à jour en
// place au renouvellement/changement de plan/annulation, pas un historique de lignes.
model Subscription {
  id String @id @default(cuid())

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  institutionId String?      @unique
  institution   Institution? @relation(fields: [institutionId], references: [id])

  planId String
  plan   Plan   @relation(fields: [planId], references: [id])

  status       SubscriptionStatus @default(ACTIVE)
  billingCycle PlanBillingCycle?

  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?

  // Générique côté fournisseur de paiement — voir src/lib/payments/. "stripe" aujourd'hui
  // (mode test uniquement, voir stripe-provider.ts), "fedapay" ou équivalent le jour de la
  // mise en prod réelle (Stripe n'est pas disponible comme fournisseur marchand au Bénin).
  providerName           String?
  providerSessionId      String?
  providerCustomerId     String?
  providerSubscriptionId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  emailVerified DateTime?
  passwordHash  String
  name          String
  role          Role
  institutionId String?
  institution   Institution? @relation(fields: [institutionId], references: [id])
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  // Vrai pour les comptes créés directement par un établissement (ex. compte jury avec
  // mot de passe temporaire) — force un changement de mot de passe avant tout accès au
  // dashboard (voir requireRole dans src/lib/auth-guard.ts), puis repasse à false.
  mustChangePassword Boolean @default(false)

  // Renseigné quand l'établissement saisi à l'inscription (étudiant/jury) ne
  // correspond à aucune Institution existante ; à rattacher manuellement plus tard.
  affiliatedInstitutionName String?
  country                   String?

  // Étudiant
  fieldOfStudy  String?
  studyLevel    StudyLevel?
  studentNumber String?

  // Jury
  specialty    String?
  juryFunction JuryFunction?

  memoiresDeposes  Memoire[]           @relation("MemoireStudent")
  evaluationsJury  DefenseEvaluation[]
  quizAttempts     QuizAttempt[]
  authTokens       AuthToken[]
  notifications    Notification[]
  documentComments DocumentComment[]
  // Abonnement étudiant — les comptes JURY n'en ont jamais (facturation étudiant/établissement
  // uniquement, voir Plan.role).
  subscription     Subscription?

  proposedThemes  Theme[]             @relation("ThemeProposedBy")
  juryAssignments MemoireAssignment[] @relation("JuryAssignments")

  // Thème choisi/proposé par l'étudiant en amont du dépôt (avant qu'un Memoire n'existe) —
  // condition pour débloquer le dépôt de mémoire. Distinct de Memoire.themeId, qui n'est
  // qu'une copie faite au moment du dépôt. N'est renseigné que via une ThemeSelection
  // APPROVED (voir plus bas) — un currentTheme pointe donc toujours vers un thème VALIDATED.
  currentThemeId String?
  currentTheme   Theme?  @relation("StudentCurrentTheme", fields: [currentThemeId], references: [id])

  // Thème verrouillé sur cet étudiant une fois sa demande de sélection approuvée — au plus
  // un thème "pris" par utilisateur (contrainte applicative, pas de @@unique ici car
  // takenByUserId vit sur Theme).
  takenThemes     Theme[]               @relation("ThemeTakenBy")
  themeSelections ThemeSelection[]
  themeClosures   ThemeClosureRequest[]
}

model AuthToken {
  id        String        @id @default(cuid())
  token     String        @unique
  type      AuthTokenType
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([userId, type])
}

// Anti-bruteforce sur la connexion (voir src/lib/rate-limit.ts) — pas de table dédiée
// jusqu'ici, donc aucune protection contre les tentatives répétées de mot de passe.
// identifier = email normalisé (pas de FK vers User : un identifiant qui ne correspond à
// aucun compte doit être rate-limité tout autant, sans quoi tenter des emails au hasard
// resterait un moyen de contourner la limite).
model LoginAttempt {
  id         String   @id @default(cuid())
  identifier String
  createdAt  DateTime @default(now())

  @@index([identifier, createdAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   String
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

model Memoire {
  id            String        @id @default(cuid())
  title         String
  // Nullables : un mémoire DRAFTED (rédigé directement dans l'éditeur, voir source
  // ci-dessous) n'a jamais de fichier source — toujours renseignés ensemble pour un
  // mémoire UPLOADED, toujours absents ensemble pour un DRAFTED.
  fileUrl       String?
  fileType      FileType?
  // Origine du mémoire : déposé par upload (comportement historique, passe par
  // processMemoire) ou rédigé à partir de zéro dans l'éditeur (status directement
  // COMPLETED à la création, editableContent pré-rempli d'un squelette — voir
  // createDraftMemoireAction). Champ technique, jamais montré à l'étudiant.
  source        MemoireSource @default(UPLOADED)
  status        MemoireStatus @default(PENDING)
  extractedText String?       @db.Text
  errorMessage  String?

  // Signature de contenu utilisée pour la détection anti-plagiat : recalculée à chaque
  // traitement, et réutilisée comme corpus de comparaison pour les mémoires suivants.
  contentEmbedding    Json?
  contentFingerprints Json?

  // Version HTML éditable du mémoire (générée à partir du DOCX via mammoth, ou reconstruite
  // par paragraphes depuis extractedText pour un PDF) — le contenu "vivant" affiché/édité
  // dans la vue document, distinct du fichier original conservé dans fileUrl.
  editableContent String? @db.Text

  // Suffixe de l'identifiant du document Y-Sweet (voir documentRoomId dans src/lib/y-sweet.ts) —
  // incrémenté à chaque régénération depuis le PDF original (regenerateDocumentContentAction).
  // Y-Sweet n'a pas d'équivalent à la suppression de room de Liveblocks : on obtient un
  // document Yjs neuf en changeant simplement l'identifiant auquel il correspond, plutôt que
  // de tenter de vider un document existant (les CRDT ne s'y prêtent pas proprement).
  documentRoomVersion Int @default(1)

  studentId     String
  student       User         @relation("MemoireStudent", fields: [studentId], references: [id])
  // Nullable : un étudiant dont l'établissement n'est pas encore rattaché à la plateforme
  // (institutionId absent sur son User, voir affiliatedInstitutionName) peut tout de même
  // déposer/rédiger son mémoire librement (voir createMemoireAction) — seules les
  // fonctionnalités qui nécessitent structurellement un établissement (assignation/évaluation
  // jury officielle, catalogue de thèmes) restent hors de portée, par construction : elles
  // filtrent toutes par institutionId non-null.
  institutionId String?
  institution   Institution? @relation(fields: [institutionId], references: [id])
  submittedAt   DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  // Thème choisi (dans la liste validée de l'établissement) ou proposé par l'étudiant —
  // nullable : un mémoire peut exister avant qu'un thème soit choisi/validé.
  themeId String?
  theme   Theme?  @relation(fields: [themeId], references: [id])

  auditReport      AuditReport?
  plagiarismReport PlagiarismReport?
  quiz             Quiz?
  jurySimulation   JurySimulation?
  evaluations      DefenseEvaluation[]
  assignments      MemoireAssignment[]
  aiChatMessages   AiChatMessage[]
  documentComments DocumentComment[]
}

// Historique de la conversation avec l'assistant IA de co-rédaction, dans l'éditeur de
// document — un mémoire = un fil de discussion continu (pas de notion de "session" séparée).
// Étudiant uniquement (voir sendAiChatMessageAction) ; jamais montré au jury.
model AiChatMessage {
  id        String   @id @default(cuid())
  memoireId String
  memoire   Memoire  @relation(fields: [memoireId], references: [id])
  role      ChatRole
  content   String   @db.Text
  createdAt DateTime @default(now())

  @@index([memoireId, createdAt])
}

// Commentaires/annotations sur le document (remplace Liveblocks Comments, retiré pour son
// badge non désactivable en tier gratuit — voir DocumentEditor.tsx). Fil simple à un niveau
// (un commentaire racine + ses réponses, pas de réponses imbriquées).
model DocumentComment {
  id        String  @id @default(cuid())
  memoireId String
  memoire   Memoire @relation(fields: [memoireId], references: [id], onDelete: Cascade)
  authorId  String
  author    User    @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String  @db.Text

  // Ancrage dans le texte, uniquement sur le commentaire racine d'un fil (les réponses
  // n'ancrent rien, elles héritent visuellement de l'ancrage du parent). Positions
  // *relatives* Yjs (Y.RelativePosition, voir absolutePositionToRelativePosition dans
  // y-prosemirror), encodées en base64 via Y.encodeRelativePosition — contrairement à un
  // simple offset ProseMirror absolu, une position relative reste valide après des éditions
  // concurrentes ailleurs dans le document, ce qui est indispensable dans un document
  // collaboratif où le texte autour du passage commenté peut changer.
  anchorFrom String? @db.Text
  anchorTo   String? @db.Text

  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parentId String?
  parent   DocumentComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  DocumentComment[] @relation("CommentReplies")

  @@index([memoireId, createdAt])
  @@index([parentId])
}

model Theme {
  id          String  @id @default(cuid())
  title       String
  description String?

  // Catégorie/domaine du thème, utilisée pour le matching avec la spécialité (User.specialty)
  // d'un jury lors de la suggestion d'assignation — comparaison texte simple (voir
  // src/lib/jury-assignment.ts), pas d'embeddings pour cette itération.
  category String

  status        ThemeStatus @default(PROPOSED)
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])

  // Renseigné si le thème a été proposé par un étudiant (à valider par l'établissement) ;
  // null si créé directement par l'établissement (déjà VALIDATED).
  proposedByUserId String?
  proposedBy       User?   @relation("ThemeProposedBy", fields: [proposedByUserId], references: [id])

  // Renseigné dès qu'une demande de sélection est approuvée pour cet étudiant — le thème
  // n'est alors plus disponible pour personne d'autre (exclusivité). Distinct du statut
  // VALIDATED du thème, qui ne concerne que sa proposition initiale.
  takenByUserId String?
  takenBy       User?   @relation("ThemeTakenBy", fields: [takenByUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memoires        Memoire[]
  currentByUsers  User[]                @relation("StudentCurrentTheme")
  selections      ThemeSelection[]
  closureRequests ThemeClosureRequest[]
}

// Demande d'un étudiant pour obtenir un thème déjà VALIDATED (établissement ou son propre
// thème proposé) — séparée du statut de proposition du thème lui-même : un thème VALIDATED
// peut avoir une sélection PENDING/APPROVED/REJECTED en cours pour un étudiant donné.
// L'approbation renseigne Theme.takenByUserId + User.currentThemeId (voir
// approveThemeSelectionAction).
model ThemeSelection {
  id        String               @id @default(cuid())
  themeId   String
  theme     Theme                @relation(fields: [themeId], references: [id])
  studentId String
  student   User                 @relation(fields: [studentId], references: [id])
  status    ThemeSelectionStatus @default(PENDING)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([themeId, status])
  @@index([studentId, status])
}

// Demande de clôture d'un thème actif par l'étudiant qui le détient (Theme.takenByUserId) —
// COMPLETED (terminé/soutenu) ou ABANDONED, soumise à validation établissement comme le
// reste du système de thèmes. Le thème reste actif/utilisable tant que la demande est
// PENDING. À l'approbation (voir approveThemeClosureAction) : COMPLETED laisse
// Theme.takenByUserId inchangé (indisponible pour toujours) tandis qu'ABANDONED le remet à
// null (redevient disponible) ; dans les deux cas User.currentThemeId de l'étudiant repasse
// à null. Ne touche jamais Memoire.themeId ni MemoireAssignment — les mémoires déjà déposés
// sous ce thème gardent leur lien et leur éventuelle assignation jury intacts.
model ThemeClosureRequest {
  id        String             @id @default(cuid())
  themeId   String
  theme     Theme              @relation(fields: [themeId], references: [id])
  studentId String
  student   User               @relation(fields: [studentId], references: [id])
  reason    ThemeClosureReason
  status    ThemeClosureStatus @default(PENDING)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([themeId, status])
  @@index([studentId, status])
}

// Historique des assignations mémoire -> jury : une nouvelle ligne à chaque changement
// (plutôt qu'une mise à jour en place), pour garder la trace de qui a été assigné et
// quand. L'assignation "active" pour un mémoire est la ligne la plus récente
// (orderBy assignedAt desc, take 1).
model MemoireAssignment {
  id         String           @id @default(cuid())
  memoireId  String
  memoire    Memoire          @relation(fields: [memoireId], references: [id])
  juryId     String
  jury       User             @relation("JuryAssignments", fields: [juryId], references: [id])
  status     AssignmentStatus @default(SUGGESTED)
  assignedAt DateTime         @default(now())

  @@index([memoireId, assignedAt])
}

model AuditReport {
  id                  String   @id @default(cuid())
  memoireId           String   @unique
  memoire             Memoire  @relation(fields: [memoireId], references: [id])
  score               Float
  structureScore      Float
  coherenceScore      Float
  writingQualityScore Float
  recommendations     Json
  createdAt           DateTime @default(now())
}

model PlagiarismReport {
  id              String   @id @default(cuid())
  memoireId       String   @unique
  memoire         Memoire  @relation(fields: [memoireId], references: [id])
  similarityScore Float
  matches         Json
  certificateUrl  String?
  qrCodeUrl       String?
  createdAt       DateTime @default(now())
}

model Quiz {
  id        String   @id @default(cuid())
  memoireId String   @unique
  memoire   Memoire  @relation(fields: [memoireId], references: [id])
  createdAt DateTime @default(now())

  questions QuizQuestion[]
  attempts  QuizAttempt[]
}

model QuizQuestion {
  id            String       @id @default(cuid())
  quizId        String
  quiz          Quiz         @relation(fields: [quizId], references: [id])
  type          QuestionType
  question      String
  choices       Json?
  correctAnswer String
  order         Int
}

model QuizAttempt {
  id          String   @id @default(cuid())
  quizId      String
  quiz        Quiz     @relation(fields: [quizId], references: [id])
  studentId   String
  student     User     @relation(fields: [studentId], references: [id])
  score       Float
  answers     Json
  completedAt DateTime @default(now())
}

model JurySimulation {
  id        String   @id @default(cuid())
  memoireId String   @unique
  memoire   Memoire  @relation(fields: [memoireId], references: [id])
  createdAt DateTime @default(now())

  questions JuryQuestion[]
}

model JuryQuestion {
  id               String               @id @default(cuid())
  jurySimulationId String
  jurySimulation   JurySimulation       @relation(fields: [jurySimulationId], references: [id])
  category         JuryQuestionCategory
  question         String
  order            Int
}

model DefenseEvaluation {
  id        String   @id @default(cuid())
  memoireId String
  memoire   Memoire  @relation(fields: [memoireId], references: [id])
  juryId    String
  jury      User     @relation(fields: [juryId], references: [id])
  grade     Float
  criteria  Json
  comments  String?
  createdAt DateTime @default(now())
  // Absente jusqu'ici alors que la note reste modifiable après soumission (voir "Revoir /
  // modifier" dans ReviewEvaluationModal.tsx) : sans ce champ, aucune trace de quand une
  // évaluation a été révisée après coup.
  updatedAt DateTime @updatedAt
}
